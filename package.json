{
  "name": "maple-timer",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src && node --test electron/sources.test.cjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ilyoon.mapletimer",
    "productName": "MapleTimer Personal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "MapleTimer-Personal-${version}-${arch}.${ext}"
  },
  "description": "개인용 메이플 화면 알림과 독립 타이머",
  "author": "ilyoon"
}
