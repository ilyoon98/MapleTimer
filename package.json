{
  "name": "maple-timer",
  "private": true,
  "version": "0.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "evidence:check": "node scripts/evidence-check.mjs",
    "test": "vitest run src && node --test electron/*.test.cjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:release": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ilyoon.mapletimer",
    "productName": "MapleTimer Personal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MapleTimer-Setup-${version}.${ext}",
      "shortcutName": "메이플 타이머",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ilyoon98",
        "repo": "MapleTimer",
        "releaseType": "release"
      }
    ]
  },
  "description": "개인용 메이플 화면 알림과 독립 타이머",
  "author": "ilyoon"
}
